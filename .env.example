# ==============================================================================
# PolyPulse Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Pipeline Operating Mode
# ------------------------------------------------------------------------------
# Mode: "demo" (synthetic repeatable market simulation) or "live" (real venue streams)
POLYPULSE_MODE=demo

# ------------------------------------------------------------------------------
# 2. Polymarket Feed Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of Polymarket CLOB asset IDs (token IDs) to stream
# Example: 21742633143463906290569050155826241533067272733775364947930777080063429301722
POLYMARKET_ASSET_IDS=

# ------------------------------------------------------------------------------
# 3. Kalshi Feed Configuration (WebSocket v2 Authenticated)
# ------------------------------------------------------------------------------
# Comma-separated list of Kalshi market tickers to subscribe
# Example: KXINTRATE-25DEC-T0.25,KXPRES-24NOV-D
KALSHI_MARKET_TICKERS=

# Kalshi API Key ID (from your Kalshi account settings)
KALSHI_API_KEY_ID=

# Local path to your private key file (PEM format, Ed25519 or RSA)
# Ensure file permissions are restricted (e.g. chmod 600)
KALSHI_PRIVATE_KEY_PATH=

# ------------------------------------------------------------------------------
# 4. Cross-Venue Verified Contract Registry
# ------------------------------------------------------------------------------
# Legacy JSON setting retained for compatibility. It does not enable spreads.
# Use the scanner's persistent contract registry to record manual verification.
MARKET_PAIRS_JSON=[]

# ------------------------------------------------------------------------------
# 5. Storage & Persistence
# ------------------------------------------------------------------------------
# ClickHouse HTTP endpoint for remote time-series batch export
# Leave empty to run without ClickHouse (SQLite WAL local journal will be used exclusively)
# For local Python, use: http://polypulse:<CLICKHOUSE_PASSWORD>@localhost:8123
CLICKHOUSE_URL=

# Local SQLite journal file path (WAL mode, acts as replay buffer and retry queue)
POLYPULSE_DB=

# Required by docker-compose.yml for the local ClickHouse user; generate a
# random password and keep this untracked file private.
CLICKHOUSE_PASSWORD=

# Optional Polygon mainnet JSON-RPC polling for confirmed V2 maker fills.
POLYGON_RPC_URL=
POLYGON_CONFIRMATIONS=12
POLYGON_START_BLOCK=
